{
  "name": "arandu",
  "version": "1.0.0",
  "private": true,
  "description": "Root workspace for Genève Latine (Editorial Platform)",
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "drizzle-orm": "^0.45.2",
    "husky": "^9.0.11",
    "jest": "^30.4.2",
    "lint-staged": "^15.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@arandu/types$": "<rootDir>/../../shared/types/index"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
